{
  "manifest_version": 3,
  "name": "Page Grabber",
  "version": "0.5.0",
  "description": "Waits for the DOM to settle, saves the rendered HTML, closes the window.",
  "permissions": ["downloads", "tabs"],
  "host_permissions": ["https://claude.ai/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/settings/usage*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
